{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "BACKEND_URL",
        "BFF_SHARED_SECRET",
        "WHATSAPP_*"
      ]
    },
    "lint": {}
  }
}
